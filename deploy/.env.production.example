# This file is a template. Copy it to .env.production and replace every placeholder.
COMPOSE_PROJECT_NAME=collector-cloud
PRODUCTION_ENV_FILE=.env.production.example

APP_BIND_PORT=8080
NOVNC_BIND_PORT=6080

POSTGRES_DB_NAME=collector
POSTGRES_DB_USER=collector
POSTGRES_DB_PWD=replace-with-a-unique-database-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
SESSION_COOKIE_SECURE=true

NOVNC_PASSWORD=replace-with-a-unique-vnc-password

# Enable all three values or leave all three empty.
AI_FILTER_API_BASE_URL=
AI_FILTER_API_KEY=
AI_FILTER_MODEL=
AI_FILTER_TIMEOUT_SECONDS=90

# CDP is forbidden in production; login is performed through noVNC.
ENABLE_CDP_MODE=false
CDP_CONNECT_EXISTING=false
CDP_HEADLESS=false
