# MySQL Configuration
MYSQL_DB_PWD=replace-with-local-only-password
MYSQL_DB_USER=root
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=media_crawler

# Redis Configuration
REDIS_DB_HOST=127.0.0.1
REDIS_DB_PWD=replace-with-local-only-password
REDIS_DB_PORT=6379
REDIS_DB_NUM=0

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PWD=
MONGODB_DB_NAME=media_crawler

# PostgreSQL Configuration
POSTGRES_DB_PWD=replace-with-local-only-password
POSTGRES_DB_USER=collector_dev
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5433
POSTGRES_DB_NAME=media_crawler

# Single administrator login (replace the password before first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
SESSION_COOKIE_SECURE=false

# Proxy Configuration (Wandou HTTP)
# your_wandou_http_app_key
WANDOU_APP_KEY=

# Proxy Configuration (Kuaidaili)
# your_kuaidaili_secret_id
KDL_SECERT_ID=
# your_kuaidaili_signature
KDL_SIGNATURE=
# your_kuaidaili_username
KDL_USER_NAME=
# your_kuaidaili_password
KDL_USER_PWD=

# Proxy Configuration (Jisu HTTP)
# Get JiSu HTTP IP extraction key value
jisu_key=
# Get JiSu HTTP IP extraction encryption signature
jisu_crypto=

# AI semantic comment filter (OpenAI-compatible cloud Chat Completions API)
# The API key is server-side only and is never returned by the management API.
# Example for DeepSeek: https://api.deepseek.com / deepseek-v4-pro
AI_FILTER_API_BASE_URL=
AI_FILTER_API_KEY=
AI_FILTER_MODEL=
AI_FILTER_TIMEOUT_SECONDS=90
